dnf -y install @@packages@@
  if ! command -v dockerd-rootless-setuptool.sh >/dev/null 2>&1; then
    dnf -y config-manager addrepo --from-repofile=https://download.docker.com/linux/fedora/docker-ce.repo \
      || dnf -y config-manager --add-repo https://download.docker.com/linux/fedora/docker-ce.repo \
      || curl -fsSL https://download.docker.com/linux/fedora/docker-ce.repo > /etc/yum.repos.d/docker-ce.repo
    dnf -y install docker-ce docker-ce-cli containerd.io docker-ce-rootless-extras docker-compose-plugin
  fi
  @@extra_setup@@