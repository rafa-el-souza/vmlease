export DEBIAN_FRONTEND=noninteractive
  apt-get update
  apt-get install -y @@packages@@
  # docker-ce via the distro-correct repo path: @@docker_repo_slug@@ (debian != ubuntu).
  if ! command -v dockerd-rootless-setuptool.sh >/dev/null 2>&1; then
    install -m 0755 -d /etc/apt/keyrings
    curl -fsSL "https://download.docker.com/linux/@@docker_repo_slug@@/gpg" \
      | gpg --batch --yes --dearmor -o /etc/apt/keyrings/docker.gpg
    chmod a+r /etc/apt/keyrings/docker.gpg
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/@@docker_repo_slug@@ $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
      > /etc/apt/sources.list.d/docker.list
    apt-get update
    apt-get install -y docker-ce docker-ce-cli containerd.io docker-ce-rootless-extras
  fi
  @@extra_setup@@